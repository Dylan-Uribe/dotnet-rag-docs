# EditorConfig — reglas de estilo del proyecto
# https://editorconfig.org  |  https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options
root = true

# ---- Todos los archivos ----
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---- C# ----
[*.cs]
indent_size = 4

# Organización de using
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# Namespaces con ámbito de archivo
csharp_style_namespace_declarations = file_scoped:suggestion

# Regla de 'var' acordada: usar 'var' solo cuando el tipo es evidente en el
# lado derecho; en caso contrario, escribir el tipo explícito.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# Tipos primitivos (int, string, bool...): un literal deja el tipo evidente.
csharp_style_var_for_built_in_types = false:suggestion

# Preferencias de C#
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:suggestion
# Revisar
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
